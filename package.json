{
  "name": "touch-bar-preview",
  "productName": "Touch Bar",
  "version": "0.9.0",
  "private": true,
  "description": "A compact Windows Touch Bar with inline volume and brightness controls.",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/build-native.cjs && electron .",
    "test:desktop": "node scripts/smoke-electron.cjs",
    "test:ai": "node scripts/smoke-ai.cjs",
    "package:local": "node scripts/build-native.cjs && node scripts/package-win.cjs --local",
    "package:win": "node scripts/build-native.cjs && node scripts/package-win.cjs",
    "package:dir": "node scripts/build-native.cjs && node scripts/package-win.cjs --dir",
    "build:native": "node scripts/build-native.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:music": "node scripts/smoke-music.cjs",
    "test:productivity": "node scripts/smoke-productivity.cjs",
    "test:widgets": "node scripts/smoke-widgets.cjs",
    "test:diy": "node scripts/smoke-diy.cjs",
    "validate:community": "node scripts/validate-community.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "local.touchbar.preview",
    "productName": "Touch Bar",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "ui/**",
      "desktop/**",
      "assets/icon.png",
      "assets/brands/**",
      "package.json",
      "skills/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Touch-Bar-Windows.exe"
    },
    "extraResources": [
      {
        "from": "native/bin/TouchBar.Controls.exe",
        "to": "native/TouchBar.Controls.exe"
      },
      {
        "from": "native/Media.ps1",
        "to": "native/Media.ps1"
      }
    ]
  },
  "author": "Chenxxxxxx06"
}
